# Non-secret Docker settings. A TLS terminator must front the loopback port.
PALLASYNC_HOST_PORT=3000
# Absolute directory containing the operator's populated privacy.md/privacy.json.
PALLASYNC_OPERATOR_DIR=
# Inject PALLASYNC_RELAY_SIGNING_SEED from protected operator key storage at launch.
# Do not save the signing seed in this file or in the repository.
